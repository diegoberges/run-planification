# Strava API app credentials — register one at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to "localhost" for local dev.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random string, 32+ characters, used by iron-session to encrypt the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# OPTIONAL. Base URL used to build the Strava OAuth redirect_uri. If unset, it's derived
# from the request host (works automatically on Vercel). Only set it locally if needed,
# e.g. http://localhost:3000 for `vercel dev`. Do NOT set it to localhost on Vercel.
APP_BASE_URL=
