# Strava API app credentials — register one at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to "localhost" for local dev.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random string, 32+ characters, used by iron-session to encrypt the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Base URL used to build the Strava OAuth redirect_uri.
# Local dev: http://localhost:3000 (the port `vercel dev` serves on)
# Production: your real deployed domain
APP_BASE_URL=http://localhost:3000
